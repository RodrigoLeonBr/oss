# .env do deploy (servidor fraco). Copie para `.env` ao lado do docker-compose.deploy.yml.
# Nunca commitar o .env real.

# Obrigatório — segredo forte (o up falha sem ele)
JWT_SECRET=troque-por-um-segredo-forte

NODE_ENV=production
PORT=4001          # porta interna da api (não publicada)
WEB_PORT=4000      # porta pública do app (nginx)

# MySQL no host do servidor. host.docker.internal = o próprio host do servidor.
# Se o banco estiver em outra máquina, ponha o IP aqui.
DOCKER_DB_HOST=host.docker.internal
DB_PORT=3306
DB_USER=oss
DB_PASS=senha-do-banco
DB_NAME=oss

# Banco producao (consultaprod, SIA/SIH) — read-only, módulo Ponte de Produção.
# Pode estar em host/credenciais diferentes do banco oss.
DB_PRODUCAO_HOST=host.docker.internal
DB_PRODUCAO_PORT=3306
DB_PRODUCAO_USER=hospital
DB_PRODUCAO_PASS=senha-do-producao
DB_PRODUCAO_NAME=producao

LOG_LEVEL=error

# Redis (padrão sem senha, dentro do compose)
REDIS_USE_PASSWORD=no
REDIS_PASSWORD=
