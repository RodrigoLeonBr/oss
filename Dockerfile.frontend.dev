# Vite dev server (porta 4000; proxy /api → serviço `api` no Compose)
FROM node:22-alpine
WORKDIR /app

COPY frontend/package.json frontend/package-lock.json* ./
RUN npm ci

COPY frontend/ ./
EXPOSE 4000

ENV API_PROXY_TARGET=http://api:4001

CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "4000"]
