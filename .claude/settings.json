{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npx tsc *)",
      "Bash(npx mocha *)",
      "Bash(npx sequelize-cli *)",
      "Bash(node src/helper/avaliacaoCumprimento.js)"
    ],
    "deny": []
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/pos-incorporacao.js\"",
            "timeout": 180
          }
        ]
      }
    ]
  }
}
