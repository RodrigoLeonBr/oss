# Copie para a raiz: cp env.docker.example .env
# Docker Compose lê o .env na raiz.

# Compose dev: Vite = WEB_PORT, API = API_PORT | Compose prod: PORT (monólito)
WEB_PORT=4000
API_PORT=4001
PORT=4001

NODE_ENV=production
# MySQL no host (XAMPP): o docker-compose injeta DOCKER_DB_HOST no container (padrão host.docker.internal).
# Pode manter DB_HOST=localhost abaixo para rodar npm start fora do Docker na mesma máquina.
# DOCKER_DB_HOST=host.docker.internal
DB_HOST=localhost
DB_PORT=3306
# XAMPP costuma ser root sem senha; se usar senha, defina DB_PASS.
DB_USER=root
DB_PASS=
DB_NAME=oss

# No MySQL do host, permita conexões vindas do Docker, por exemplo:
# CREATE DATABASE oss CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
# CREATE USER IF NOT EXISTS 'oss'@'%' IDENTIFIED BY 'sua_senha';
# GRANT ALL ON oss.* TO 'oss'@'%';
# FLUSH PRIVILEGES;
# (Ou use root@'%' só em desenvolvimento.)

JWT_SECRET=defina-uma-chave-longa-e-aleatoria
JWT_ACCESS_EXPIRATION_MINUTES=60
JWT_REFRESH_EXPIRATION_DAYS=30

LOG_FOLDER=logs/
LOG_FILE=%DATE%-app-log.log
LOG_LEVEL=error

# Redis continua no Docker — hostname do serviço é "redis"
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USE_PASSWORD=no
REDIS_PASSWORD=

# Banco de produção (segundario, para ponte de avaliação)
DB_PRODUCAO_HOST=localhost
DB_PRODUCAO_PORT=3306
DB_PRODUCAO_USER=hospital
DB_PRODUCAO_PASS=tebaldi
DB_PRODUCAO_NAME=producao
